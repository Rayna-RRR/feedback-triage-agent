DEEPSEEK_API_KEY=
FEEDBACK_TRIAGE_WEB_LLM_ENABLED=false

# Optional DeepSeek overrides
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20

# Web runtime defaults
FEEDBACK_TRIAGE_RUN_RETENTION_HOURS=24
FEEDBACK_TRIAGE_MAX_WEB_RUNS=50
FEEDBACK_TRIAGE_WEB_RUNS_DIR=

# Post-release risk workbench task storage
# Local JSON remains the default; Vercel requires PostgreSQL.
FEEDBACK_RISK_TASKS_DIR=
# Optional locally; Vercel selects postgresql and rejects json.
FEEDBACK_RISK_STORAGE_BACKEND=
# Set through your local secret store / Vercel console. Never commit a real URL.
FEEDBACK_RISK_DATABASE_URL=
# DATABASE_URL / POSTGRES_URL are also accepted if the app-specific URL is absent.
# Leave unset for production / automatic per-branch Preview namespaces.
# Explicit Preview namespaces must start with preview_ or preview-.
FEEDBACK_RISK_DB_NAMESPACE=
