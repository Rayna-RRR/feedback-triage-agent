DEEPSEEK_API_KEY=
FEEDBACK_TRIAGE_WEB_LLM_ENABLED=false

# Optional DeepSeek overrides
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20

# Web runtime defaults
FEEDBACK_TRIAGE_RUN_RETENTION_HOURS=24
FEEDBACK_TRIAGE_MAX_WEB_RUNS=50
FEEDBACK_TRIAGE_WEB_RUNS_DIR=

# Post-release risk workbench task storage
# Local JSON/file persistence only. Vercel defaults to ephemeral /tmp storage.
FEEDBACK_RISK_TASKS_DIR=
